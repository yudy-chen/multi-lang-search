# Copy this file to `.env` and fill the values in. `.env` is git-ignored; this file is
# not, and it must never hold a real key.

# --- where the inference comes from --------------------------------------------------
# `main.py` asks one OpenAI-compatible endpoint for every chat model: the query
# translation, the result cards, the detail panel, and -- when there is no `GEMINI_KEY`
# -- the model that reads a picture. Anything that speaks POST /chat/completions will
# do; these are the ones this was checked against, and the `.env` name each key goes in:
#
#   Radeon (default)  https://developer.amd.com.cn/radeon/api/v1                AMD_AI_TOKEN
#   DeepSeek          https://api.deepseek.com                                  AI_API_KEY
#   Gemini, free tier https://generativelanguage.googleapis.com/v1beta/openai/  GEMINI_KEY
#   OpenRouter        https://openrouter.ai/api/v1                              OPENROUTER_API_KEY
#   Ollama, local     http://localhost:11434/v1                                 any string
#
# Leave both unset for the Radeon endpoint and the token below. Setting them here is
# the whole change: no line of `main.py` moves.
# AI_BASE_URL=
# AI_API_KEY=

# The Radeon AI endpoint's token. Read when `AI_API_KEY` is not set, so an `.env` that
# predates the two lines above keeps working as it is.
AMD_AI_TOKEN=

# The model names. Every endpoint serves different ones, and a name it does not serve
# is a 404 per request rather than a crash, so an endpoint change means these change
# too. Unset is the Radeon name, i.e. the defaults in `main.py`.
#   QUERY_MODEL     the query and the detail panel      default DeepSeek-V4-Flash
#   RESULT_MODEL    the result cards                    default Gemma-4-31B-IT
#   DETAIL_MODEL    the detail panel only               default = QUERY_MODEL
#   IMAGE_MODEL     reads a picture (needs vision)      default Gemma-4-31B-IT
# QUERY_MODEL=
# RESULT_MODEL=
# DETAIL_MODEL=
# IMAGE_MODEL=

# A Google AI Studio key, used by the picture step only (`PICTURE_MODEL`). Without it
# the app still runs: the wording is read off the picture by `IMAGE_MODEL` and
# lettered back onto the same picture with Pillow instead. If the chat endpoint above
# is Gemini, the same key is `AI_API_KEY` as well.
GEMINI_KEY=

# Where the picture step keeps the picture that went out and the picture that came back,
# for the console block that says how much of it the model changed. Unset is a
# `translated_pictures` folder beside `main.py`, falling back to the same name under the
# temp directory when that folder is read-only -- which is what a hosted runner gives you
# (Vercel serves from `/var/task` and writes only under `/tmp`). Set it to an absolute
# path to keep the files somewhere that outlives the process; the step runs either way,
# and a host that writes nowhere says `kept: nothing` and still shows the picture.
# PICTURE_DIR=
