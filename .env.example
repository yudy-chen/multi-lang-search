# Copy this file to `.env` and fill the values in. `.env` is git-ignored; this file is
# not, and it must never hold a real key.

# The Radeon AI endpoint's token. Every chat model in `main.py` is asked through it:
# the query translation, the result cards and the detail panel.
AMD_AI_TOKEN=

# A Google AI Studio key, used by the picture step only (`PICTURE_MODEL`). Without it
# the app still runs: the wording is read off the picture by `IMAGE_MODEL` and
# lettered back onto the same picture with Pillow instead.
GEMINI_KEY=
